# PostgreSQL
DB_USER=inventory_user
DB_PASSWORD=change_this_password
DB_NAME=device_inventory

# JWT — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change_this_jwt_secret

# Seed users — default passwords forced to change on first login
SEED_ADMIN_PASSWORD=Admin@ChangeMe1!
SEED_MANAGER_PASSWORD=Manager@ChangeMe1!
SEED_USER_PASSWORD=User@ChangeMe1!
